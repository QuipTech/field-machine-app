<?xml version="1.0" encoding="utf-8"?>
<!--
  Remote-control accessibility service. It performs gestures and edits the
  focused field only while an active Portal support session has control
  (approved on the tablet, or started with the tablet password). To edit text it reads the focused field; it never stores or sends
  that text.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:description="@string/remote_input_description"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100" />
